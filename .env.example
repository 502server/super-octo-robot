NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BOOTSTRAP_TOKEN=replace-with-a-separate-random-token-at-least-24-characters
DATA_FILE=./data/state.json
# Optional: set DATABASE_URL to enable PostgreSQL-backed state storage.
# Use the Fly Managed Postgres PgBouncer URL for the application runtime.
DATABASE_URL=
PG_POOL_MAX=3
TRUST_PROXY=0
ALLOWED_ORIGIN=http://localhost:3000

# DeepSeek (server-side only; never place this key in browser code)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Hasura Cloud (server-side only)
HASURA_GRAPHQL_ENDPOINT=https://thankful-beagle-31.hasura.app/v1/graphql
HASURA_ADMIN_SECRET=
HASURA_JWT_SECRET=
