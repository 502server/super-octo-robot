NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BOOTSTRAP_TOKEN=replace-with-a-separate-random-token-at-least-24-characters
DATA_FILE=./data/state.json
# Required for hosted application state and Better Auth. Use a rotated credential and a URL-encoded password.
# TLS certificate verification is always enabled; MARIADB_SSL_CA is optional PEM content for the provider CA.
MARIADB_URL=
MARIADB_SSL_CA=
MARIADB_POOL_MAX=5
TRUST_PROXY=0
ALLOWED_ORIGIN=https://502-devbot.vercel.app

# DeepSeek (server-side only; never place this key in browser code)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Hasura Cloud (server-side only)
HASURA_GRAPHQL_ENDPOINT=https://thankful-beagle-31.hasura.app/v1/graphql
HASURA_ADMIN_SECRET=
HASURA_JWT_SECRET=
